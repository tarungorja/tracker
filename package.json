{
  "name": "hair-health-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Hair Health Tracker — track hair-care medications, log daily completion, and monitor daily wellness. Built with Next.js 15.",
  
  "scripts": {
    "dev": "dotenv -e .env.development -- next dev",
    "dev:prod": "dotenv -e .env.production -- next dev",
    "build": "dotenv -e .env.production -- next build",
    "build:dev": "dotenv -e .env.development -- next build",
    "start": "dotenv -e .env.production -- next start",
    "start:dev": "dotenv -e .env.development -- next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.577.0",
    "mongoose": "^8.24.8",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}

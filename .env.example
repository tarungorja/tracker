# ─────────────────────────────────────────────────────────────
# Hair Reminder — environment variables
# Copy this file to `.env.local` for local development and add
# the same variables in the Vercel dashboard for production.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string.
# Atlas → Database → Connect → Drivers. Include the database name.
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/hair-reminder?retryWrites=true&w=majority
MONGODB_URI=

# Resend API key (https://resend.com/api-keys). Starts with "re_".
RESEND_API_KEY=

# The verified sender address for reminder emails.
# Must be on a domain you verified in Resend, or use onboarding@resend.dev for testing.
FROM_EMAIL="Hair Reminder <onboarding@resend.dev>"

# Where reminder emails are delivered (your inbox).
NOTIFICATION_EMAIL=you@example.com

# ── Optional ────────────────────────────────────────────────

# Public base URL of the deployment. Used to build the absolute link
# for the "I have completed this" button inside emails.
# On Vercel this is auto-detected from VERCEL_URL, so you can leave it blank.
NEXT_PUBLIC_APP_URL=

# Secret used to authorize the Vercel Cron request to /api/cron/reminders.
# If set, Vercel automatically sends it as a Bearer token to your cron path.
# Generate with: openssl rand -hex 32
CRON_SECRET=

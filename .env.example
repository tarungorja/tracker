# Copy the env file for the mode you need, then fill in real credentials:
#   cp .env.development.example .env.development
#   cp .env.production.example  .env.production
#
# Scripts (see package.json):
#   npm run dev        → .env.development
#   npm run build      → .env.production
#   npm run start      → .env.production
#   npm run build:dev  → .env.development
#   npm run start:dev  → .env.development
#   npm run dev:prod   → .env.production
#
# Database name is `health` (path after the host).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/health
